{
  "name": "renpy-sound-picker",
  "displayName": "Ren'Py Sound Picker",
  "description": "Preview, insert, and check project sounds and music in Ren'Py scripts.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "GPL-2.0-only",
  "private": true,
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "keywords": ["renpy", "visual-novel", "audio", "sound", "music"],
  "main": "./extension.js",
  "activationEvents": ["workspaceContains:**/*.rpy", "workspaceContains:**/*.rpym"],
  "scripts": {
    "check": "node --check extension.js && node --check audioReferences.js && node --check audioIndex.js && node --check audioMetadata.js && node --check media\\picker.js",
    "test": "node --test test\\*.test.js",
    "test:extension": "node test\\runExtensionTests.js",
    "vscode:prepublish": "npm run check",
    "package": "npx --yes @vscode/vsce@4.1.1 package --allow-missing-repository"
  },
  "dependencies": {
    "music-metadata": "11.16.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2",
    "playwright-core": "1.65.1"
  },
  "contributes": {
    "commands": [
      { "command": "renpySoundPicker.playSound", "title": "Ren'Py: Play Sound at Cursor", "icon": "$(play)" },
      { "command": "renpySoundPicker.insertSoundFromProject", "title": "Ren'Py: Insert Sound From Project", "icon": "$(unmute)" },
      { "command": "renpySoundPicker.listMissingSounds", "title": "Ren'Py: List Missing Static Sounds", "icon": "$(list-selection)" },
      { "command": "renpySoundPicker.rescanMissingSounds", "title": "Ren'Py: Rescan Missing Static Sounds", "icon": "$(refresh)" },
      { "command": "renpySoundPicker.refreshIndex", "title": "Ren'Py: Refresh Sound Index", "icon": "$(refresh)" }
    ],
    "configuration": {
      "title": "Ren'Py Sound Picker",
      "properties": {
        "renpySoundPicker.audioDirectories": {
          "type": "array",
          "scope": "resource",
          "items": { "type": "string" },
          "default": ["audio"],
          "description": "Game-relative audio lookup directories, in order, matching your config.audio_directories. The game directory is always searched first. Python configuration is not evaluated."
        },
        "renpySoundPicker.markMissingSounds": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Warn about definitively missing static sound files. Expression statements and unverifiable dynamic/archive references are not marked missing."
        },
        "renpySoundPicker.keepSoundPickerOpen": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Keep the sound picker open after inserting a sound."
        }
      }
    },
    "menus": {
      "editor/context": [
        { "command": "renpySoundPicker.playSound", "when": "resourceExtname == .rpy || resourceExtname == .rpym", "group": "navigation" },
        { "command": "renpySoundPicker.insertSoundFromProject", "when": "resourceExtname == .rpy || resourceExtname == .rpym", "group": "navigation" }
      ],
      "editor/title": [
        { "command": "renpySoundPicker.listMissingSounds", "when": "resourceExtname == .rpy || resourceExtname == .rpym", "group": "navigation@2" },
        { "command": "renpySoundPicker.rescanMissingSounds", "when": "resourceExtname == .rpy || resourceExtname == .rpym", "group": "navigation@3" }
      ],
      "webview/title": [
        { "command": "renpySoundPicker.listMissingSounds", "when": "webviewId == renpySoundPicker", "group": "navigation" },
        { "command": "renpySoundPicker.rescanMissingSounds", "when": "webviewId == renpySoundPicker", "group": "navigation@2" }
      ]
    }
  }
}
